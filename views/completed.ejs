<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Todo App </title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <!-- navbar -->
  <nav class="navbar bg-body-tertiary sticky-top">
    <form class="container-fluid justify-content-start">
      <a href="/task">
        <button class="btn btn-success me-2" type="button">Current</button>
      </a>
      <a href="/task/leaved">
        <button class="btn btn-warning me-2" type="button">Leaved</button>
      </a>
      <a href="">
        <button class="btn btn-danger me-2" type="button">Deleted</button>
      </a>
    </form>
  </nav>

  

  <div class="container-fluid px-3 py-5">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th colspan="2" class="text-center bg-success text-light">Completed Tasks</th>
        </tr>
        <tr>
          <th scope="col">Tasks</th>
          <th scope="col">Reassign Task</th>
          
        </tr>
      </thead>
      <tbody>
        <% for (task of tasks) { %>
        <tr>
          <th scope="row"><%=task.task %></th>
          <td>
            <form method="post" action="/completed/reassign/<%= task.id %>?_method=PUT" >
              <button class="bt">➕</button>
            </form>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>